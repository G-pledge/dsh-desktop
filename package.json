{
  "name": "dsh-desktop",
  "version": "1.0.0",
  "description": "DeepSeek Harness desktop shell",
  "main": "src/main.js",
  "author": "G-pledge",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win dir --publish never && node scripts/copy-config.mjs",
    "pack:win": "electron-builder --win dir --publish never && node scripts/copy-config.mjs",
    "zip:win": "node scripts/zip-win.mjs",
    "pack:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.gpledge.dsh-desktop",
    "productName": "DeepSeek Harness",
    "directories": {
      "output": "dist"
    },
    "publish": null,
    "files": [
      "src/**/*",
      "build/icon.ico",
      "build/icon.png",
      "build/tray.png",
      "build/icon-64.png",
      "config.example.json",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ],
      "signExecutable": false
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-mac.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        },
        {
          "target": "zip",
          "arch": ["universal"]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "asar": true
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2"
  }
}
